# Backend: local development
#DATABASE_URL=postgresql://paperless:paperless@localhost:5432/paperlesscheck
FLASK_ENV=development

# Docker Compose: database configuration
POSTGRES_USER=paperless
POSTGRES_PASSWORD=
POSTGRES_DB=paperlesscheck

# Docker frontend build-time API root (default: same-origin /api)
VITE_API_BASE_URL=/api
